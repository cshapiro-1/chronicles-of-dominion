grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="CrisisModal"]
layout_mode = 2
theme_override_constants/margin_left = 24
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 24
theme_override_constants/margin_bottom = 20

[node name="VBox" type="VBoxContainer" parent="CrisisModal/Margin"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="CrisisModal/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.85, 0.3, 1)
theme_override_fonts/font = ExtResource("11_font_serif")
theme_override_font_sizes/font_size = 20
text = "CRISIS DECREE TITLE"
horizontal_alignment = 1

[node name="Description" type="Label" parent="CrisisModal/Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/font_color = Color(0.9, 0.88, 0.82, 1)
theme_override_font_sizes/font_size = 13
text = "Crisis narrative description and provincial impact..."
autowrap_mode = 2

[node name="HBoxOptions" type="HBoxContainer" parent="CrisisModal/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Option1" type="Button" parent="CrisisModal/Margin/VBox/HBoxOptions"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
size_flags_horizontal = 3
text = "DECREE OPTION 1"

[node name="Option2" type="Button" parent="CrisisModal/Margin/VBox/HBoxOptions"]
custom_minimum_size = Vector2(0, 48)
layout_mode = 2
size_flags_horizontal = 3
text = "DECREE OPTION 2"

[connection signal="pressed" from="ActionDock/ActionRibbon/Btn1" to="." method="_on_action_spearmen_pressed"]
[connection signal="pressed" from="ActionDock/ActionRibbon/Btn2" to="." method="_on_action_slingers_pressed"]
[connection signal="pressed" from="ActionDock/ActionRibbon/Btn3" to="." method="_on_action_chariots_pressed"]
[connection signal="pressed" from="ActionDock/ActionRibbon/Btn4" to="." method="_on_action_formation_pressed"]
[connection signal="pressed" from="ActionDock/ActionRibbon/Btn5" to="." method="_on_action_raider_wave_pressed"]
[connection signal="pressed" from="CrisisModal/Margin/VBox/HBoxOptions/Option1" to="." method="_on_crisis_option_pressed" binds= [0]]
[connection signal="pressed" from="CrisisModal/Margin/VBox/HBoxOptions/Option2" to="." method="_on_crisis_option_pressed" binds= [1]]
