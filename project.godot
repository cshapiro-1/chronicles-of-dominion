; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Chronicles of Dominion"
config/description="Mythic Grimdark Bronze Age City-State RTS / City-Builder Hybrid"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

MatchSignals="*res://scripts/core/MatchSignals.gd"
EventBus="*res://scripts/systems/EventBus.gd"
MeshFactory="*res://scripts/systems/MeshFactory.gd"
GameManager="*res://scripts/systems/GameManager.gd"
EconomyManager="*res://scripts/systems/EconomyManager.gd"
PopulationManager="*res://scripts/systems/PopulationManager.gd"
FormationManager="*res://scripts/systems/FormationManager.gd"
MilitaryManager="*res://scripts/systems/MilitaryManager.gd"
SupplyManager="*res://scripts/systems/SupplyManager.gd"
PoliticsManager="*res://scripts/systems/PoliticsManager.gd"
ReligionManager="*res://scripts/systems/ReligionManager.gd"
CrisisManager="*res://scripts/systems/CrisisManager.gd"
SaveManager="*res://scripts/systems/SaveManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

